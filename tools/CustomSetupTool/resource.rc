IDD_WELCOME DIALOGEX 0, 0, 408, 234
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "System Informer 安装程序"
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_SIDEBAR,"Static",SS_BITMAP,21,20,140,212
    LTEXT           "欢迎使用 System Informer 安装向导",IDC_TITLE,148,4,250,34
    LTEXT           "这将在该计算机上安装 System Informer。System Informer 可帮助您监视系统资源、调试软件并检测恶意软件。",IDC_STATIC,148,55,240,30
    LTEXT           "建议您在继续之前关闭所有其他应用程序。",IDC_STATIC,148,94,240,18
    LTEXT           "单击“下一步”继续，或单击“取消”退出安装。",IDC_STATIC,148,126,240,14
END

IDD_UNINSTALL_WELCOME DIALOGEX 0, 0, 408, 234
