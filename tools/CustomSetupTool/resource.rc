    LTEXT           "安装程序将把 System Informer 安装到以下文件夹。",IDC_STATIC,25,40,358,10
    LTEXT           "单击“下一步”继续。如果要选择其他文件夹，请单击“浏览”。",IDC_STATIC,25,64,358,10
    EDITTEXT        IDC_PATH,25,78,301,14,ES_AUTOHSCROLL,WS_EX_CLIENTEDGE
    PUSHBUTTON      "浏览...",IDC_BROWSE,334,77,49,16
END

IDD_SHORTCUTS DIALOGEX 0, 0, 408, 234
